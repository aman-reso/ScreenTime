package com.app.screentime.config

/**
 * Application Secrets and Configuration Template
 * 
 * IMPORTANT: Copy this file to AppSecrets.kt and fill in your actual values
 * Add AppSecrets.kt to .gitignore to prevent committing secrets
 * 
 * For production, consider using:
 * - BuildConfig fields (set in build.gradle.kts)
 * - Firebase Remote Config
 * - Android Keystore System
 * - local.properties (gitignored)
 */
object AppSecrets {
    
    /**
     * API Base URLs
     * These should be moved to BuildConfig or Remote Config in production
     */
    object Api {
        // Production API URL
        const val DEFAULT_BASE_URL = "YOUR_PRODUCTION_API_URL"
        
        // Development/Testing URL (ngrok)
        const val DEV_BASE_URL = "YOUR_DEV_API_URL"
    }
    
    /**
     * TOTP Secrets
     * This is a fallback secret - actual secrets come from server
     */
    object TOTP {
        // Fallback TOTP secret (should only be used if server secret is unavailable)
        const val FALLBACK_SECRET = "YOUR_TOTP_FALLBACK_SECRET"
    }
    
    /**
     * Encryption Keys
     * Key aliases and algorithm names
     */
    object Encryption {
        const val KEY_ALIAS = "device_encryption_key"
        const val TRANSFORMATION = "AES/GCM/NoPadding"
        const val ANDROID_KEYSTORE = "AndroidKeyStore"
        const val KEY_SIZE = 32 // 256-bit key
        const val IV_SIZE = 12  // GCM standard
    }
    
    /**
     * Firebase Configuration Keys
     */
    object Firebase {
        const val REMOTE_CONFIG_KEY_BASE_URL = "api_base_url"
        const val REMOTE_CONFIG_CACHE_EXPIRATION_SECONDS: Long = 3600L // 1 hour
    }
    
    /**
     * Preference Keys
     */
    object Preferences {
        const val PREF_FCM_TOKEN = "fcm_token"
    }
}

