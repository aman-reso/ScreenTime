<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.8"
    android:background="@color/background_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/lock_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Locked Feature"
        android:src="@drawable/rounded_lock_clock_24"
        android:tint="@color/background_light" />

    <!-- Title -->
    <TextView
        android:id="@+id/overlay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/fredoka_medium"
        android:text="Feature Locked"
        android:textColor="@color/background_light"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/overlay_description"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/fredoka_regular"
        android:gravity="center"
        android:text="@string/unfortunately_this_content_is_blocked_please_take_a_break_or_try_again_later"
        android:textColor="@color/background_light"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_ok"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_outline_button"
        android:elevation="0dp"
        android:fontFamily="@font/fredoka_regular"
        android:paddingHorizontal="32dp"
        android:text="Close App"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/emergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:fontFamily="@font/fredoka_light"
        android:padding="8dp"
        android:paddingHorizontal="32dp"
        android:text="Emergency Use"
        android:textAllCaps="false"
        android:textColor="@color/background_light"
        android:textStyle="bold" />
</LinearLayout>
