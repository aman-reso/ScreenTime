    <!-- Device Admin Policy -->
    <string name="device_admin_policy">Politique d\'administration d\'appareil</string>
    <string name="device_admin_policy_description">La politique d\'administration d\'appareil permet des fonctionnalités améliorées de gestion d\'appareil pour un meilleur contrôle sur les paramètres et restrictions de votre appareil. Cette fonctionnalité est optionnelle et peut être désactivée à tout moment.</string>
    <string name="device_admin_policy_explanation">ScreenTime utilise l\'administration d\'appareil pour fournir des fonctionnalités de mode concentration comme le verrouillage de votre écran et la désactivation temporaire de la caméra pendant les sessions de concentration. Cela vous aide à rester concentré et à réduire les distractions. Vous pouvez désactiver cette fonctionnalité à tout moment depuis les paramètres.</string>
    <string name="device_admin_policy_info">La politique d\'administration d\'appareil fournit des fonctionnalités de mode concentration comme le verrouillage d\'écran et le contrôle de la caméra. C\'est complètement optionnel et vous pouvez le désactiver à tout moment depuis cet écran ou depuis Paramètres Android > Sécurité > Applications d\'administration d\'appareil. ScreenTime ne vous empêchera jamais de désinstaller l\'application ou de désactiver l\'administration d\'appareil.</string>
    <string name="device_admin_active">Administration d\'appareil active</string>
    <string name="device_admin_inactive">Administration d\'appareil inactive</string>
    <string name="device_admin_active_description">La politique d\'administration d\'appareil est actuellement active. Vous avez des capacités améliorées de gestion d\'appareil activées.</string>
    <string name="device_admin_inactive_description">La politique d\'administration d\'appareil n\'est pas active. Activez-la pour accéder aux fonctionnalités avancées de gestion d\'appareil.</string>
    <string name="enable_device_admin">Activer l\'administration d\'appareil</string>
    <string name="disable_device_admin">Désactiver l\'administration d\'appareil</string>
    <string name="device_admin_disable_warning">La désactivation de l\'administration d\'appareil supprimera les fonctionnalités améliorées de gestion d\'appareil. Êtes-vous sûr de vouloir continuer ?</string>
    
