<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 🌙 App main theme -->
    <style name="Theme.ScreenTime" parent="android:Theme.Material.NoActionBar">
        <item name="android:supportsPictureInPicture">true</item>
    </style>

    <!-- 🚀 Splash Screen Theme -->
    <style name="Theme.ScreenTime.Splash" parent="Theme.SplashScreen">
        <!-- Solid background (no weird blending) -->
        <item name="windowSplashScreenBackground">@color/splash_dark_blue</item>

        <!-- Your static or animated splash icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/rounded_hourglass_24</item>

        <!-- Optional animation duration -->
        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- Where to go after splash -->
        <item name="postSplashScreenTheme">@style/Theme.ScreenTime</item>
    </style>

</resources>

