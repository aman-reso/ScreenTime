    <string name="permissions_card_description">আপনার অ্যাপ ব্যবহার ট্র্যাক করতে ScreenTime নিম্নলিখিত অনুমতি প্রয়োজন:</string>

    <!-- Detailed Permission Explanation -->
    <string name="permission_explanation_title">কেন আমাদের অ্যাপ ব্যবহার ডেটা প্রয়োজন</string>
    <string name="permission_explanation_detail">আপনার ডিজিটাল অভ্যাসের সঠিক অন্তর্দৃষ্টি প্রদান করতে, ScreenTime আপনার অ্যাপ ব্যবহার পরিসংখ্যান অ্যাক্সেস প্রয়োজন। এই অনুমতি আমাদেরকে ট্র্যাক করতে দেয় যে আপনি কোন অ্যাপ্লিকেশন ব্যবহার করেন এবং প্রত্যেকটিতে কত সময় ব্যয় করেন।</string>

    <string name="permission_why_required">কেন এই অনুমতি অপরিহার্য</string>
    <string name="permission_why_required_detail">এই অনুমতি ছাড়া, আমরা আপনার স্ক্রিন টাইম সঠিকভাবে পরিমাপ করতে পারি না, আপনার সবচেয়ে বেশি ব্যবহৃত অ্যাপগুলি চিহ্নিত করতে পারি না, বা আপনার ডিজিটাল স্বাস্থ্য সম্পর্কে অর্থপূর্ণ অন্তর্দৃষ্টি প্রদান করতে পারি না। এই ডেটা ScreenTime-এর সকল বৈশিষ্ট্যের ভিত্তি, যার মধ্যে দৈনিক ব্যবহার রিপোর্ট, অ্যাপ ব্যবহার প্রবণতা এবং ব্যক্তিগতকৃত সুপারিশ অন্তর্ভুক্ত।</string>

    <string name="permission_what_we_track">আমরা কী ট্র্যাক করি</string>
    <string name="permission_what_we_track_detail">আমরা শুধুমাত্র অপরিহার্য তথ্য ট্র্যাক করি: অ্যাপ নাম, ব্যবহার সময়কাল এবং টাইমস্ট্যাম্প। আমরা আপনার ব্যক্তিগত ডেটা, বার্তা, পাসওয়ার্ড বা অ্যাপের মধ্যে কোন সংবেদনশীল তথ্য অ্যাক্সেস করি না। আপনার গোপনীয়তা আমাদের সর্বোচ্চ অগ্রাধিকার।</string>

    <string name="permission_privacy_assurance">আপনার গোপনীয়তা সুরক্ষিত</string>
    <string name="permission_privacy_assurance_detail">সকল ব্যবহার ডেটা আপনার ডিভাইসে স্থানীয়ভাবে সংরক্ষিত হয় এবং শুধুমাত্র আপনার ব্যক্তিগত স্ক্রিন টাইম রিপোর্ট তৈরি করতে ব্যবহার করা হয়। আমরা কখনও আপনার ডেটা তৃতীয় পক্ষের সাথে শেয়ার করি না, এবং আপনি যেকোনো সময় ডিভাইস সেটিংসের মাধ্যমে এই অনুমতি প্রত্যাহার করতে পারেন।</string>

